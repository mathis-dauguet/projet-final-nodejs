# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

POSTGRES_USER=app
POSTGRES_DB=final_project_nodejs
# openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>

# Required, no default value: generate with `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=3600

BCRYPT_COST=12

CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

API_DEFAULT_VERSION=v1

# Taille maximale du corps de requête, en octets
BODY_LIMIT=1048576
